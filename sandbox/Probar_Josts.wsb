<Configuration>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Josts\dist</HostFolder>
      <SandboxFolder>C:\JostsApp</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Josts\sandbox</HostFolder>
      <SandboxFolder>C:\JostsSandbox</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File C:\JostsSandbox\iniciar.ps1</Command>
  </LogonCommand>
</Configuration>
